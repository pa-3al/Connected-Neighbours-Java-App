<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.infrastructure.ui.MainController" prefHeight="600.0" prefWidth="800.0">
    <center>
        <SplitPane fx:id="mainSplitPane" dividerPositions="0.25" VBox.vgrow="ALWAYS" styleClass="main-split-pane">
            <items>
                <StackPane fx:id="sidebarContainer" minWidth="0" maxWidth="400">
                    <VBox fx:id="sidebar" id="sidebar" styleClass="sidebar" spacing="15">
                        <padding>
                            <Insets top="20" right="16" bottom="20" left="16"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="navHeaderLabel" text="%nav.header" styleClass="sidebar-header" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>

                        <VBox spacing="2">
                            <Label text="%nav.section.general" styleClass="sidebar-category-title"/>
                            <Button text="%nav.home" fx:id="btnHome" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showHome"/>
                            <Button text="%nav.incidents" fx:id="btnIncidents" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showIncidents"/>
                            <Button text="%nav.query" fx:id="btnQuery" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showQuery"/>
                            <Button text="%nav.plugins" fx:id="btnPlugins" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showPlugins"/>
                            <Button text="%nav.themes" fx:id="btnTheme" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showThemes"/>
                        </VBox>

                        <VBox spacing="2">
                            <Label text="%nav.section.plugins" styleClass="sidebar-category-title"/>
                            <VBox fx:id="pluginsNavContainer" spacing="2"/>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <VBox spacing="2">
                            <Label text="%nav.section.settings" styleClass="sidebar-category-title"/>
                            <Button text="%settings.title" fx:id="btnSettings" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showSettings"/>
                        </VBox>
                    </VBox>
                </StackPane>

                <BorderPane fx:id="contentArea" styleClass="content-area">
                    <top>
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 0 0;">
                            <Button text="☰" fx:id="btnContentSidebarToggle" styleClass="icon-button" onAction="#handleToggleSidebar" style="-fx-font-size: 16px; -fx-background-color: transparent; -fx-padding: 10; -fx-cursor: hand;"/>
                        </HBox>
                    </top>
                    <center>
                        <Label text="%main.placeholder.welcome" styleClass="placeholder-text"/>
                    </center>
                </BorderPane>
            </items>
        </SplitPane>
    </center>
    <bottom>
        <HBox style="-fx-padding: 5; -fx-background-color: #202020;">
            <Label fx:id="statusLabel" text="%main.status.ready" style="-fx-text-fill: #c9d1d9;" />
        </HBox>
    </bottom>
</BorderPane>