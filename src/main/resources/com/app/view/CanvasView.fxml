<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.app.infrastructure.ui.CanvasController" spacing="0" stylesheets="@../../../themes/default.css">
    
    <HBox spacing="15" alignment="CENTER_LEFT" styleClass="tool-bar">
        <padding>
            <Insets top="10" right="15" bottom="10" left="15"/>
        </padding>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="btnDraw" onAction="#onDrawMode" styleClass="tool-button">
                <graphic>
                    <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" 
                             styleClass="tool-icon-path"/>
                </graphic>
                <tooltip><Tooltip text="%tool.brush"/></tooltip>
            </Button>
            
            <Button fx:id="btnErase" onAction="#onEraseMode" styleClass="tool-button">
                <graphic>
                    <SVGPath content="M16.24 3.56l4.95 4.94c.78.79.78 2.05 0 2.84L12 20.53a4.008 4.008 0 0 1-5.66 0L2.81 17c-.78-.79-.78-2.05 0-2.84l10.6-10.6c.79-.78 2.05-.78 2.83 0zM4.22 15.58l3.54 3.54c.78.78 2.05.78 2.83 0l8.49-8.49-3.54-3.54-8.49 8.49c-.78.78-.78 2.05-.01 2.84z" 
                             styleClass="tool-icon-path"/>
                </graphic>
                <tooltip><Tooltip text="%tool.eraser"/></tooltip>
            </Button>
         
            <ColorPicker fx:id="colorPicker" styleClass="tool-color-picker"/>
        </HBox>

        <Separator orientation="VERTICAL" />

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="%action.import" onAction="#onImport" styleClass="button-secondary, button-icon">
                 <tooltip><Tooltip text="%action.file.import.title"/></tooltip>
                 <graphic>
                    <SVGPath content="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" styleClass="tool-icon-small"/>
                 </graphic>
            </Button>
            <Button text="%action.export" onAction="#onExport" styleClass="button-secondary, button-icon">
                 <tooltip><Tooltip text="%action.file.export.title"/></tooltip>
                 <graphic>
                    <SVGPath content="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2v9.67z" styleClass="tool-icon-small"/>
                 </graphic>
            </Button>
        </HBox>

        <Separator orientation="VERTICAL" />

        <HBox spacing="8" alignment="CENTER_LEFT" HBox.hgrow="NEVER">
            <SVGPath content="M7 14c-1.66 0-3 1.34-3 3 0 1.31-1.16 2-2 2 .92 1.22 2.49 2 4 2 2.21 0 4-1.79 4-4 0-1.66-1.34-3-3-3z M20.71 4.63l-1.34-1.34c-.39-.39-1.02-.39-1.41 0L9 12.25 11.75 15l8.96-8.96c.39-.39.39-1.02 0-1.41z" 
                     scaleX="0.7" scaleY="0.7" styleClass="tool-icon-small"/>
            
            <Slider fx:id="sizeSlider" min="1" max="50" value="5" prefWidth="150" />
            <Label fx:id="lblBrushSize" text="5px" styleClass="tool-label-numeric" prefWidth="35"/>
        </HBox>
        
        <Region HBox.hgrow="ALWAYS" />

        <Button text="%action.clear" onAction="#onClear" styleClass="tool-button-danger"/>
    </HBox>

    <StackPane fx:id="viewport" VBox.vgrow="ALWAYS" style="-fx-background-color: #1e1e1e;">
        <StackPane fx:id="zoomGroup">
             <Rectangle fx:id="paperParams" width="800" height="600" fill="WHITE" />
             <Canvas fx:id="canvas" width="800" height="600" />
        </StackPane>
    </StackPane>
</VBox>