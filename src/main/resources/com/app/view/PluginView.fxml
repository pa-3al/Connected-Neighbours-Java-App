<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.app.infrastructure.ui.PluginController"
    fx:id="pluginRoot"
      spacing="15" styleClass="plugin-view">
    <padding><Insets topRightBottomLeft="20"/></padding>
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="%plugin.title" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" text="0 plugin(s)" styleClass="count-label"/>
        <Button text="%plugin.add" onAction="#handleAddPlugin" styleClass="primary-button"/>
        <Button text="%plugin.refresh" onAction="#handleRefreshPlugins" styleClass="secondary-button"/>
    </HBox>
    <Separator/>
    <VBox spacing="8" styleClass="card info-card">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="%plugin.guide.title" styleClass="card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="%plugin.guide.button" onAction="#handleOpenGuide" styleClass="secondary-button" style="-fx-font-size: 11;"/>
        </HBox>
        <Label text="%plugin.install.instruction" wrapText="true"/>
        <Label text="%plugin.install.note" wrapText="true" styleClass="text-muted"/>
    </VBox>
    <Label fx:id="statusLabel" text="" styleClass="status-label"/>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="plugins-scroll">
        <FlowPane fx:id="pluginsContainer" 
                  hgap="15" vgap="15" 
                  prefWrapLength="700"
                  styleClass="plugins-container"/>
    </ScrollPane>
</VBox>
