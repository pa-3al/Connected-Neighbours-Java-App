<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="query-view">
    <padding><Insets topRightBottomLeft="20"/></padding>
    
    <Label text="%query.title" styleClass="section-title"/>
    <Separator/>
    
    <VBox spacing="10" styleClass="card">
        <Label text="%query.input.label" styleClass="card-title"/>
        <HBox spacing="10">
            <TextField fx:id="queryInput" promptText="%query.input.placeholder" HBox.hgrow="ALWAYS"
                       styleClass="text-field"/>
            <Button text="%query.execute" styleClass="primary-button"/>
        </HBox>
        <Label text="%query.syntax" styleClass="text-muted"/>
    </VBox>
    
    <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="card">
        <Label text="%query.results.title" styleClass="card-title"/>
        <TextArea fx:id="resultsArea" editable="false" VBox.vgrow="ALWAYS" 
                  styleClass="text-area, log-area" promptText="%query.results.placeholder"/>
    </VBox>
</VBox>
