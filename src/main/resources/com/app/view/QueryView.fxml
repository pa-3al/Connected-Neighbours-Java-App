<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="15"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.app.infrastructure.ui.QueryController"
      styleClass="query-view">
    <padding><Insets topRightBottomLeft="20"/></padding>

    <Label text="%query.title" styleClass="section-title"/>
    <Separator/>

    <VBox spacing="10" styleClass="card">
        <Label text="%query.input.label" styleClass="card-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label fx:id="promptLabel" text="Voisinea>" styleClass="text-muted"/>
            <TextField fx:id="queryInput"
                       promptText="%query.input.placeholder"
                       HBox.hgrow="ALWAYS"
                       styleClass="text-field"/>
            <Button fx:id="executeButton"
                    text="%query.execute"
                    styleClass="primary-button"
                    onAction="#executeQuery"/>
            <Button fx:id="clearButton"
                    text="Réinitialiser"
                    styleClass="secondary-button"
                    onAction="#clearConsole"/>
            <Button fx:id="reconnectButton"
                    text="Relancer"
                    styleClass="button-primary"
                    onAction="#handleReconnect"
                    visible="false"
                    managed="false"/>
        </HBox>
        <Label text="%query.syntax" styleClass="text-muted"/>
    </VBox>

    <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="%query.results.title" styleClass="card-title" HBox.hgrow="ALWAYS"/>
        </HBox>
        <ScrollPane fx:id="resultsScroll"
                    fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    styleClass="log-scroll"
                    focusTraversable="false">
            <TextFlow fx:id="resultsFlow" styleClass="log-area">
                <padding><Insets topRightBottomLeft="8"/></padding>
            </TextFlow>
        </ScrollPane>
    </VBox>
</VBox>
